# Скопируй в .env и заполни. Файл .env не коммитится и защищён хуком от записи агентом.

APP_ENV=local
LOG_LEVEL=INFO

# PostgreSQL
# Версия прибита проектом: postgres:16-alpine (docker-compose.yml и testcontainers
# обязаны использовать ровно её; менять только синхронно во всех местах).
POSTGRES_IMAGE=postgres:16-alpine
POSTGRES_USER=reserve
POSTGRES_PASSWORD=reserve
POSTGRES_DB=reserve
POSTGRES_HOST=localhost
POSTGRES_PORT=5439
DATABASE_URL=postgresql+asyncpg://reserve:reserve@localhost:5439/reserve

# HMAC-подпись входящих callback'ов
CALLBACK_HMAC_SECRET=change-me
# Окно валидности timestamp против replay, секунд
CALLBACK_TIMESTAMP_WINDOW_SECONDS=300

# Время жизни неподтверждённого резерва (PENDING -> EXPIRED), секунд
RESERVATION_TTL_SECONDS=900
